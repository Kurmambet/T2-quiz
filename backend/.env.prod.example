APP_NAME="T2 Quiz Rooms API"
APP_ENV=production
DEBUG=false
APP_SECRET_KEY=replace_me_with_a_long_random_secret
API_V1_PREFIX=/api/v1

POSTGRES_DB=t2_quiz
POSTGRES_USER=t2_quiz
POSTGRES_PASSWORD=replace_me_with_a_long_database_password

DATABASE_URL=postgresql+asyncpg://t2_quiz:replace_me_with_a_long_database_password@db:5432/t2_quiz
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
SQL_ECHO=false

REDIS_URL=redis://redis:6379/0

REALTIME_PRESENCE_TTL_SECONDS=45
REALTIME_HEARTBEAT_INTERVAL_SECONDS=15


CORS_ORIGINS=["https://hushme.fun","https://www.hushme.fun"]
